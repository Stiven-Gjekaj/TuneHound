/* The palette of the banner. See assets/palette.md. */
$th-panel: #070b14;
$th-panel-2: #0f172a;
$th-border: #1e3a4a;
$th-cyan: #22d3ee;
$th-blue: #60a5fa;
$th-violet: #a78bfa;
$th-pink: #f472b6;
$th-pale: #e0e7ff;
$th-dim: #64748b;

Screen {
    background: $th-panel;
    color: $th-pale;
}

/* The header is one line. The wordmark sits at the left, the tagline at the
   right. */
#header {
    height: 3;
    background: $th-panel-2;
    border-bottom: solid $th-border;
    padding: 0 2;
}

#wordmark {
    width: auto;
    content-align: left middle;
    height: 100%;
}

#tagline {
    width: 1fr;
    height: 100%;
    content-align: right middle;
    color: $th-dim;
}

#link {
    margin: 1 2 0 2;
    background: $th-panel-2;
    border: tall $th-border;
    color: $th-pale;
}

#link:focus {
    border: tall $th-cyan;
}

#link > .input--placeholder {
    color: $th-dim;
}

#link > .input--cursor {
    background: $th-pink;
    color: $th-panel;
}

#queue-area {
    height: 1fr;
    margin: 1 2 0 2;
    layers: base overlay;
}

#queue {
    layer: base;
    height: 100%;
    background: $th-panel;
    color: $th-pale;
    scrollbar-background: $th-panel-2;
    scrollbar-color: $th-border;
}

#queue > .datatable--header {
    background: $th-panel-2;
    color: $th-cyan;
    text-style: bold;
}

#queue > .datatable--even-row {
    background: $th-panel-2 40%;
}

#queue > .datatable--cursor {
    background: $th-violet 30%;
    color: $th-pale;
}

#queue:focus > .datatable--cursor {
    background: $th-violet 55%;
}

#empty {
    layer: overlay;
    width: 100%;
    height: 100%;
    background: transparent;
    color: $th-dim;
    content-align: center middle;
    text-align: center;
}

#status {
    height: 1;
    margin: 1 2 0 2;
    padding: 0 1;
    background: $th-panel-2;
    color: $th-cyan;
}

Footer {
    background: $th-panel-2;
    color: $th-dim;
}

Footer > .footer--key {
    background: $th-border;
    color: $th-cyan;
}

Footer > .footer--description {
    color: $th-pale;
}
